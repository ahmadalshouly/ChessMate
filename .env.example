# Copy to .env (git-ignored) and fill in what you need. Everything is optional
# for local development. `docker compose --profile server` reads .env; when
# running `pnpm dev:server` directly, set these in your shell instead. See docs/DEPLOYMENT.md for the full reference.

# ---- Game server ----
PORT=8787
# NODE_ENV=production          # disables dev-only login tokens

# Database: Postgres in production. Without DATABASE_URL the server uses
# embedded Postgres (PGlite) stored in DATABASE_PATH.
# DATABASE_URL=postgres://chessmate:chessmate@localhost:5432/chessmate
# DATABASE_PATH=.data/pglite
# DATABASE_POOL_MAX=10

# Engine: native Stockfish binary. Unset = npm WASM build (slower, no install).
# STOCKFISH_PATH=/usr/games/stockfish
# ENGINE_WORKERS=1
# ENGINE_THREADS=1
# ENGINE_HASH_MB=64

# ---- App (Expo) ----
# Only EXPO_PUBLIC_* values reach the app, and they are baked in at build time.
# Leave unset in development: the app finds the server on your LAN.
# EXPO_PUBLIC_SERVER_URL=wss://chessmate-server.fly.dev/ws
