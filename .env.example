# Copy to .env (git-ignored) and fill in what you need. Everything is optional
# for local development. `docker compose --profile server` reads .env; when
# `pnpm dev:server` reads it too (server settings only). See docs/DEPLOYMENT.md for the full reference.

# ---- Game server ----
PORT=8787
# NODE_ENV=production          # disables dev-only login tokens

# Database: Postgres in production. Without DATABASE_URL the server uses
# embedded Postgres (PGlite) stored in DATABASE_PATH.
# DATABASE_URL=postgres://chessmate:chessmate@localhost:5432/chessmate
# DATABASE_PATH=.data/pglite
# DATABASE_POOL_MAX=10

# Engine: native Stockfish binary. Unset = npm WASM build (slower, no install).
# STOCKFISH_PATH=/usr/games/stockfish
# ENGINE_WORKERS=1
# ENGINE_THREADS=1
# ENGINE_HASH_MB=64

# Sign in with Google: the Google OAuth client IDs (web, iOS, Android), comma-separated.
# See docs/sign-in-with-google-and-apple.md. Unset = Google sign-in off.
# GOOGLE_CLIENT_IDS=123-web.apps.googleusercontent.com,123-ios.apps.googleusercontent.com,123-android.apps.googleusercontent.com
# Sign in with Apple: accepted audiences. Default com.chessmate.app (plus Expo Go outside production).
# APPLE_CLIENT_IDS=com.chessmate.app

# ---- App (Expo) ----
# For local development put EXPO_PUBLIC_* values in apps/app/.env (Expo reads that file).
# Only EXPO_PUBLIC_* values reach the app, and they are baked in at build time.
# Leave unset in development: the app finds the server on your LAN.
# EXPO_PUBLIC_SERVER_URL=wss://chessmate-server.fly.dev/ws

# Staff console (/admin): usernames that become admins at startup or when they sign up.
# Comma-separated. Or run `pnpm admin:grant <username> [admin|moderator|user]` once.
# ADMIN_USERNAMES=ahmad
# Public address of the server, used for links it hands out (title proof files). Optional.
# PUBLIC_URL=https://chessmate-server.fly.dev

# Token signing secret for sign-in. Required in production (openssl rand -hex 32).
# AUTH_SECRET=

# Sign in with Google in the app (put these in apps/app/.env).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123-web.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123-ios.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123-android.apps.googleusercontent.com

# Email (fair-play/moderation notices, password resets). Default "log" prints emails in the server terminal.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=ChessMate <no-reply@yourdomain.com>
