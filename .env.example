# Copy to .env (git-ignored) and fill in what you need. Everything is optional
# for local development. `docker compose --profile server` reads .env; when
# `pnpm dev:server` reads it too (server settings only). See docs/DEPLOYMENT.md for the full reference.

# ---- Game server ----
PORT=8787
# NODE_ENV=production          # disables dev-only login tokens

# Database: Postgres in production. Without DATABASE_URL the server uses
# embedded Postgres (PGlite) stored in DATABASE_PATH.
# DATABASE_URL=postgres://chessmate:chessmate@localhost:5432/chessmate
# DATABASE_PATH=.data/pglite
# DATABASE_POOL_MAX=10

# Engine: native Stockfish binary. Unset = npm WASM build (slower, no install).
# STOCKFISH_PATH=/usr/games/stockfish
# ENGINE_WORKERS=1
# ENGINE_THREADS=1
# ENGINE_HASH_MB=64

# Sign in with Google: the Google OAuth client IDs (web, iOS, Android), comma-separated.
# See docs/sign-in-with-google-and-apple.md. Unset = Google sign-in off.
# GOOGLE_CLIENT_IDS=123-web.apps.googleusercontent.com,123-ios.apps.googleusercontent.com,123-android.apps.googleusercontent.com
# Sign in with Apple: accepted audiences. Default com.chessmate.app (plus Expo Go outside production).
# APPLE_CLIENT_IDS=com.chessmate.app
# Sign in with Apple on the web: the Services ID (also EXPO_PUBLIC_APPLE_SERVICES_ID in the app).
# APPLE_SERVICES_ID=com.chessmate.web

# Streamers show as live automatically (with viewer counts). All optional:
# Twitch: a free app at https://dev.twitch.tv/console (Client ID + secret). Without it Twitch isn't checked.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YouTube is checked without a key; a free YouTube Data API v3 key adds title, viewers and start time.
# YOUTUBE_API_KEY=
# Kick: a free app at https://kick.com/settings/developer. Without it Kick's site API is tried (may refuse).
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=

# Dig Deep (opening explorer): a free Lichess personal token, no scopes needed
# (https://lichess.org/account/oauth/token). Without it only the ChessMate tab works.
# LICHESS_TOKEN=
# LICHESS_EXPLORER_URL=https://explorer.lichess.ovh

# ---- App (Expo) ----
# For local development put EXPO_PUBLIC_* values in apps/app/.env (Expo reads that file).
# Only EXPO_PUBLIC_* values reach the app, and they are baked in at build time.
# Leave unset in development: the app finds the server on your LAN.
# EXPO_PUBLIC_SERVER_URL=wss://chessmate-server.fly.dev/ws

# Staff console (/admin): usernames that become admins at startup or when they sign up.
# Comma-separated. Or run `pnpm admin:grant <username> [admin|moderator|user]` once.
# ADMIN_USERNAMES=ahmad
# Public address of the server, used for links it hands out (title proof files). Optional.
# PUBLIC_URL=https://chessmate-server.fly.dev
# Behind a proxy: where rate limits read the player's IP (fly = Fly-Client-IP, 1 = last X-Forwarded-For entry).
# TRUST_PROXY=fly

# Email (password resets, moderation notices: warnings, chat mutes, bans, closures).
# Sent through Resend (https://resend.com) when both are set; otherwise printed to the server console.
# RESEND_API_KEY=re_...
# MAIL_FROM=ChessMate <no-reply@your-domain.com>
# APP_WEB_URL=https://chessmate.app

# Stripe: tournament entry fees, donations and sponsor payment links. Without the secret key all three are off.
# In the Stripe dashboard, add a webhook to https://<your server>/api/stripe/webhook for
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed and checkout.session.expired.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: staff inbox emailed when a sponsor replies or pays.
# SPONSOR_INBOX_EMAIL=team@example.com

# Token signing secret for sign-in. Required in production (openssl rand -hex 32).
# AUTH_SECRET=

# Sign in with Google and Apple in the app (put these in apps/app/.env).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123-web.apps.googleusercontent.com
# Google Analytics 4 on the website (Admin → Data streams → Web → Measurement ID). See docs/ANALYTICS.md.
# EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123-ios.apps.googleusercontent.com
# (Android uses the web client ID with Google's native SDK; the Android client only has to exist in Google Cloud.)
# Sign in with Apple on the web (https only):
# EXPO_PUBLIC_APPLE_SERVICES_ID=com.chessmate.web

# Push notifications go through Expo. Only needed when "Enhanced push security" is on
# for the Expo project. Apple/Google keys live in Expo: see docs/PUSH_NOTIFICATIONS.md
# EXPO_ACCESS_TOKEN=
